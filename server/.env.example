PORT=4000
DATABASE_URL=postgres://signallab:signallab@localhost:5432/signallab

# Binance public market data (no API key needed).
# If api.binance.com is blocked where you are (HTTP 451), use the market-data mirror:
#   BINANCE_REST_URL=https://data-api.binance.vision
#   BINANCE_WS_URL=wss://data-stream.binance.vision
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443

# Coins are defined in src/coins.js. Set SYMBOLS only to narrow that list or add a pair:
#   SYMBOLS=BTCUSDT,ETHUSDT

# Derivatives data, kept apart from spot. No key needed. Change these only if Binance moves them.
# BINANCE_FUTURES_REST_URL=https://fapi.binance.com
# BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/market

# Paper trading costs
PAPER_FEE_RATE=0.001
PAPER_SLIPPAGE_BPS=5

# Optional: Claude writes a plain-language explanation of each signal
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
